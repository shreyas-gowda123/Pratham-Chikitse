<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cardiac Arrest"
            android:textSize="28sp"
            android:textStyle="bold"
            android:paddingBottom="12dp"/>

        <!-- Symptoms -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Symptoms"
            android:textStyle="bold"
            android:textSize="22sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Sudden collapse\n• No breathing\n• Unconsciousness\n• No pulse"
            android:textSize="18sp"
            android:paddingBottom="16dp"/>

        <!-- First Aid -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Immediate First Aid"
            android:textStyle="bold"
            android:textSize="22sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Call emergency services.\n2. Start CPR.\n3. Use AED if available."
            android:textSize="18sp"
            android:paddingBottom="16dp"/>

        <!-- Do Not -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Do Not"
            android:textStyle="bold"
            android:textSize="22sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Do not delay CPR\n• Do not shake the patient"
            android:textSize="18sp"/>

    </LinearLayout>

</ScrollView>